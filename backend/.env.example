# Copie este arquivo para ".env" e preencha os valores. Nunca faça commit do ".env" real.

# Obrigatória. Gere sua chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional. Modelo Gemini usado pelo agente (precisa suportar function calling).
GEMINI_MODEL=gemini-2.5-flash

# Opcional. Token de assinatura gratuito da API da FIPE (https://fipe.api.br),
# eleva o limite de 500 para 1.000 requisições/dia. A aplicação funciona sem ele.
FIPE_API_TOKEN=

# Opcional. Origens permitidas por CORS para o frontend, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000
